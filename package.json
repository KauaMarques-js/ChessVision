{
  "name": "chessvision-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Central de administra\u00e7\u00e3o do ChessVision Lab 2.1",
  "author": "ChessVision Lab",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win --dir --x64 && node scripts/uninstall-manifest.cjs && electron-builder --win nsis --x64 --prepackaged release/win-unpacked",
    "build:helper": "node scripts/build-helper.cjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "jsdom": "^31.0.0",
    "vite": "7.2.2"
  },
  "build": {
    "appId": "com.chessvision.manager",
    "productName": "ChessVision Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/chessvision-helper.exe",
        "to": "chessvision-helper.exe"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "ChessVision-Manager-Setup-${version}-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ChessVision Manager",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "script": "resources/installer.nsi",
      "differentialPackage": false,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    }
  }
}
